<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: la app no guarda nada que valga la pena copiar (la configuración vive en el
    robot), así que se excluye todo de la copia en la nube y de la transferencia entre equipos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
