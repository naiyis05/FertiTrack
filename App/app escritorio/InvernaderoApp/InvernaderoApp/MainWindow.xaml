<Window x:Class="InvernaderoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SmartGreenhouse" Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#F0F4F8"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="Navegación"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#6B7280" Margin="0,0,0,20"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <Button x:Name="BtnDashboard" Content="🏠  Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnDashboard_Click"/>
                    <Button x:Name="BtnInvernadero" Content="🌿  Invernadero"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnInvernadero_Click"/>
                    <Button x:Name="BtnGraficas" Content="📈  Gráficas"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnGraficas_Click"/>
                    <Button x:Name="BtnControl" Content="⚙️  Control"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnControl_Click"/>
                    <Button x:Name="BtnAnalisis" Content="📊  Análisis"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnAnalisis_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════ ÁREA PRINCIPAL ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#22C55E" CornerRadius="10"
                                Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="🌿" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FertiTrack"
                                       FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Sistema de Monitoreo y Control en Tiempo Real"
                                       FontSize="12" Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Estado conexiones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse x:Name="PuntoConexion" Width="10" Height="10"
                                     Fill="#D1D5DB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Maestro" FontSize="10" Foreground="#9CA3AF" LineHeight="13"/>
                                <TextBlock x:Name="TextoConexion" Text="Sin conexión"
                                           FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="1" Height="28" Background="#E5E7EB" Margin="0,0,16,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PuntoEsclavo" Width="10" Height="10"
                                     Fill="#D1D5DB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Esclavo" FontSize="10" Foreground="#9CA3AF" LineHeight="13"/>
                                <TextBlock x:Name="TextoEsclavo" Text="Sin conexión"
                                           FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- ══════════ DASHBOARD ══════════ -->
                    <Grid x:Name="PanelDashboard" Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="16"
                                Margin="0,0,16,0" Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="Estado del Invernadero"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,16"/>

                                <Border x:Name="TarjetaHumedad" Background="#F0FDF4"
                                        CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Humedad del Suelo"
                                                       FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock x:Name="TxtHumedadNum" Text="--"
                                                           FontSize="42" FontWeight="Bold" Foreground="#111827"/>
                                                <TextBlock Text="%" FontSize="22" Foreground="#6B7280"
                                                           VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtEstadoSuelo" Text="Esperando datos..."
                                                       FontSize="15" FontWeight="Medium" Foreground="#374151"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="10" Margin="4,0"
                                            Padding="8,10" Background="#F3F4F6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse x:Name="PuntoHumedo" Width="12" Height="12"
                                                     Fill="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Húmedo" FontSize="12" Foreground="#6B7280"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="10" Margin="4,0"
                                            Padding="8,10" Background="#F3F4F6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse x:Name="PuntoIntermedio" Width="12" Height="12"
                                                     Fill="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Intermedio" FontSize="12" Foreground="#6B7280"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="10" Margin="4,0"
                                            Padding="8,10" Background="#F3F4F6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse x:Name="PuntoSeco" Width="12" Height="12"
                                                     Fill="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Seco" FontSize="12" Foreground="#6B7280"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Mini tarjeta Esclavo -->
                                <Border Background="#F0F9FF" CornerRadius="12"
                                        BorderBrush="#BAE6FD" BorderThickness="1"
                                        Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📡  ESCLAVO — Sensor en tiempo real"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#0369A1" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ADC:" FontSize="12" Foreground="#6B7280" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtADCEsclavo" Text="--"
                                                           FontSize="12" FontWeight="Bold" Foreground="#0C4A6E"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Lecturas:" FontSize="12" Foreground="#6B7280" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtLecturaEsclavo" Text="--"
                                                           FontSize="12" FontWeight="Bold" Foreground="#0C4A6E"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse x:Name="PuntoEsclavoDash" Width="10" Height="10"
                                                     Fill="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtEstadoEsclavoDash" Text="OFF"
                                                       FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#F9FAFB" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="📈  Humedad en Tiempo Real"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#6B7280" Margin="0,0,0,8"/>
                                        <lvc:CartesianChart Height="160"
                                                            Series="{Binding Series}"
                                                            XAxes="{Binding EjesX}"
                                                            YAxes="{Binding EjesY}"
                                                            TooltipPosition="Hidden"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Background="White" CornerRadius="16"
                                    Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
                                <Grid Margin="20">
                                    <StackPanel>
                                        <Border x:Name="TarjetaFertilizacion" Visibility="Collapsed"
                                                Background="#FFFBEB" CornerRadius="16"
                                                BorderBrush="#FCD34D" BorderThickness="2"
                                                Padding="16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="⚠️" FontSize="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Confirmación de Fertilización"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="#92400E" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="El suelo está seco. ¿Deseas iniciar el ciclo de fertilización ahora?"
                                                           FontSize="12" Foreground="#78350F"
                                                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="Ignorar"
                                                            Click="BtnNoFertilizar_Click"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="#B45309" Cursor="Hand"/>
                                                    <Button Grid.Column="1" Content="SÍ, EMPEZAR"
                                                            Click="BtnSiFertilizar_Click"
                                                            Background="#F59E0B" Foreground="White"
                                                            FontWeight="Bold" Padding="10,6" Cursor="Hand"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="#F3F4F6" CornerRadius="20" Padding="14,6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRiego" Text="Inactivo"
                                                   FontSize="13" Foreground="#6B7280"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="White" CornerRadius="16"
                                    Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
                                <StackPanel Margin="20">
                                    <TextBlock Text="ESTADO DE LA MÁQUINA"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PuntoMaquina" Width="10" Height="10"
                                                 Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtEstadoMaquina" Text="⏸ En espera"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#111827" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#F0FDF4" CornerRadius="16"
                                    BorderBrush="#BBF7D0" BorderThickness="1"
                                    Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ANÁLISIS AUTOMÁTICO"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtAnalisis"
                                               Text="Esperando datos del sensor..."
                                               FontSize="13" Foreground="#15803D" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="16"
                                    Effect="{StaticResource CardShadow}" MaxHeight="200">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Eventos del Sistema"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#111827" Margin="0,0,0,12"/>
                                    <ListBox x:Name="ListaEventos" BorderThickness="0"
                                             Background="Transparent" MaxHeight="140"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ INVERNADERO ══════════ -->
                    <Grid x:Name="PanelInvernadero" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Título + badge día/noche -->
                            <RowDefinition Height="170"/>    <!-- Cielo -->
                            <RowDefinition Height="300"/>    <!-- Estructura del invernadero -->
                            <RowDefinition Height="Auto"/>   <!-- Barra de estado -->
                        </Grid.RowDefinitions>

                        <!-- ── Título ── -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🌿  Invernadero en Tiempo Real"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#111827"
                                       VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <!-- Hora actual -->
                                <TextBlock x:Name="TxtHoraInvernadero"
                                           FontSize="13" Foreground="#6B7280"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <!-- Badge día / noche -->
                                <Border CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF9C3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                    <Setter Property="Background" Value="#1E3A5F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="13" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="☀️  Día"/>
                                                <Setter Property="Foreground" Value="#92400E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                        <Setter Property="Text" Value="🌙  Noche"/>
                                                        <Setter Property="Foreground" Value="#BAE6FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── CIELO ── -->
                        <Border Grid.Row="1" CornerRadius="16,16,0,0" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#38BDF8" Offset="0"/>
                                                <GradientStop Color="#BAE6FD" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNight}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#0C1A2E" Offset="0"/>
                                                        <GradientStop Color="#1B3358" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- Sol (día) -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,-20,200,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- Halo del sol -->
                                    <Ellipse Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#80FFD700" Offset="0.4"/>
                                                <GradientStop Color="#00FFD700" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Disco del sol -->
                                    <Ellipse Width="56" Height="56" Fill="#FFD700"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Luna + estrellas (noche) -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- Estrellas (TextBlocks posicionados) -->
                                    <TextBlock Text="✦" FontSize="10" Foreground="#FFFFFFB0"
                                               Margin="80,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="7" Foreground="#FFFFFF80"
                                               Margin="200,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="12" Foreground="#FFFFFFA0"
                                               Margin="380,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="8" Foreground="#FFFFFF60"
                                               Margin="520,35,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="10" Foreground="#FFFFFF90"
                                               Margin="680,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="6" Foreground="#FFFFFF70"
                                               Margin="140,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <TextBlock Text="✦" FontSize="9" Foreground="#FFFFFF80"
                                               Margin="450,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- Luna -->
                                    <TextBlock Text="🌙" FontSize="52"
                                               Margin="0,-10,220,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Nubes (solo día) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="40,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Background="#CCFFFFFF" CornerRadius="20"
                                            Width="90" Height="28" Margin="0,0,30,0"/>
                                    <Border Background="#AAFFFFFF" CornerRadius="20"
                                            Width="60" Height="22" Margin="0,0,80,0"/>
                                    <Border Background="#BBFFFFFF" CornerRadius="20"
                                            Width="110" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── ESTRUCTURA DEL INVERNADERO ── -->
                        <Border Grid.Row="2" CornerRadius="0,0,16,16"
                                BorderBrush="#86EFAC" BorderThickness="2,0,2,2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0FDF4" Offset="0"/>
                                    <GradientStop Color="#DCFCE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>    <!-- Zona de plantas -->
                                    <RowDefinition Height="44"/>   <!-- Riel del robot -->
                                    <RowDefinition Height="36"/>   <!-- Suelo -->
                                </Grid.RowDefinitions>

                                <!-- ── Divisores verticales de sectores ── -->
                                <Border Grid.Row="0" Grid.RowSpan="2"
                                        BorderBrush="#86EFAC" BorderThickness="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Separador 1|2 -->
                                        <Border Grid.Column="1" Background="#86EFAC"/>
                                        <!-- Separador 2|3 -->
                                        <Border Grid.Column="3" Background="#86EFAC"/>

                                        <!-- ══ SECTOR 1 ══ -->
                                        <Border Grid.Column="0" Padding="12,12,12,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SectorActual}" Value="1">
                                                            <Setter Property="Background" Value="#CCFEF08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="1">
                                                                        <Setter Property="Background" Value="#FEF08A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="SECTOR 1" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="1">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>

                                                <TextBlock HorizontalAlignment="Center" FontSize="28"
                   Margin="0,0,0,8" TextAlignment="Center" LineHeight="34">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🌿 🌿 🌿&#10;🌿 🌿 🌿"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Text" Value="🌵 🌵 🌵&#10;🌵 🌵 🌵"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="Humedad" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                <ProgressBar Value="{Binding Humedad}" Minimum="0" Maximum="100"
                     Height="10" Margin="0,0,0,4" BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#374151"
                   Text="{Binding Humedad, StringFormat={}{0:F0}%}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Separador 1|2 -->
                                        <Border Grid.Column="1" Background="#86EFAC"/>

                                        <!-- ══ SECTOR 2 ══ -->
                                        <Border Grid.Column="2" Padding="12,12,12,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SectorActual}" Value="2">
                                                            <Setter Property="Background" Value="#CCFEF08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="2">
                                                                        <Setter Property="Background" Value="#FEF08A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="SECTOR 2" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="2">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>

                                                <TextBlock HorizontalAlignment="Center" FontSize="28"
                   Margin="0,0,0,8" TextAlignment="Center" LineHeight="34">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🌿 🌿 🌿&#10;🌿 🌿 🌿"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Text" Value="🌵 🌵 🌵&#10;🌵 🌵 🌵"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="Humedad" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                <ProgressBar Value="{Binding Humedad}" Minimum="0" Maximum="100"
                     Height="10" Margin="0,0,0,4" BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#374151"
                   Text="{Binding Humedad, StringFormat={}{0:F0}%}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Separador 2|3 -->
                                        <Border Grid.Column="3" Background="#86EFAC"/>

                                        <!-- ══ SECTOR 3 ══ -->
                                        <Border Grid.Column="4" Padding="12,12,12,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SectorActual}" Value="3">
                                                            <Setter Property="Background" Value="#CCFEF08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="3">
                                                                        <Setter Property="Background" Value="#FEF08A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="SECTOR 3" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SectorActual}" Value="3">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>

                                                <TextBlock HorizontalAlignment="Center" FontSize="28"
                   Margin="0,0,0,8" TextAlignment="Center" LineHeight="34">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🌿 🌿 🌿&#10;🌿 🌿 🌿"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Text" Value="🌵 🌵 🌵&#10;🌵 🌵 🌵"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="Humedad" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                <ProgressBar Value="{Binding Humedad}" Minimum="0" Maximum="100"
                     Height="10" Margin="0,0,0,4" BorderThickness="0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstadoSuelo}" Value="SECO">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#374151"
                   Text="{Binding Humedad, StringFormat={}{0:F0}%}"/>
                                            </StackPanel>
                                        </Border>


                                    </Grid>
                                </Border>

                                <!-- ── RIEL DEL ROBOT ── -->
                                <Border Grid.Row="1" Background="#E5E7EB" Margin="0,0,0,0">
                                    <Grid>
                                        <!-- Línea del riel -->
                                        <Border Height="3" Background="#9CA3AF"
                                                VerticalAlignment="Center" Margin="20,0"/>

                                        <!-- Robot en 3 posiciones posibles -->
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Robot en Sector 1 -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SectorActual}" Value="1">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="🤖" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="S1" FontSize="9" FontWeight="Bold"
                                                           Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Robot en Sector 2 -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SectorActual}" Value="2">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="🤖" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="S2" FontSize="9" FontWeight="Bold"
                                                           Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Robot en Sector 3 -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SectorActual}" Value="3">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="🤖" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="S3" FontSize="9" FontWeight="Bold"
                                                           Foreground="#374151" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Robot en origen (SectorActual = 0) -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SectorActual}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="🤖" FontSize="22" HorizontalAlignment="Center"/>
                                                <TextBlock Text="INICIO" FontSize="8" FontWeight="Bold"
                                                           Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ── SUELO ── -->
                                <Border Grid.Row="2" CornerRadius="0,0,14,14" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#92400E" Offset="0"/>
                                            <GradientStop Color="#78350F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <ProgressBar Value="{Binding Humedad}" Minimum="0" Maximum="100" 
                     Background="Transparent" BorderThickness="0" Opacity="0.35"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                            <ProgressBar.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0EA5E9" Offset="0"/>
                                                    <GradientStop Color="#0EA5E900" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Foreground>

                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Bomba1Activa}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <TextBlock Text="suelo" FontSize="10" Foreground="#D97706"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic" Opacity="0.6"/>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- ── BARRA DE ESTADO ── -->
                        <Border Grid.Row="3" Background="White" CornerRadius="12"
                                Margin="0,12,0,0" Padding="20,14"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bomba riego -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#D1D5DB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BombaRiegoActiva}" Value="True">
                                                        <Setter Property="Fill" Value="#2563EB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="Bomba Riego" FontSize="11" Foreground="#6B7280"/>
                                        <TextBlock FontSize="13" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactiva"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BombaRiegoActiva}" Value="True">
                                                            <Setter Property="Text" Value="💧 REGANDO"/>
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Fertilización -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#D1D5DB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BombaFertilizanteActiva}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="Fertilizante" FontSize="11" Foreground="#6B7280"/>
                                        <TextBlock FontSize="13" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactivo"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BombaFertilizanteActiva}" Value="True">
                                                            <Setter Property="Text" Value="🌱 ACTIVO"/>
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Humedad global -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Humedad global" FontSize="11" Foreground="#6B7280"/>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#374151"
                                               Text="{Binding Humedad, StringFormat={}{0:F0}%}"/>
                                </StackPanel>

                                <!-- Estado máquina -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Estado robot" FontSize="11" Foreground="#6B7280"/>
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#374151"
                                               Text="{Binding EstadoMaquina}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ══════════ GRÁFICAS ══════════ -->
                    <Grid x:Name="PanelGraficas" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="16"
                                Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="Humedad del Suelo"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,16"/>
                                <lvc:CartesianChart Height="300"
                                                    Series="{Binding Series}"
                                                    XAxes="{Binding EjesX}"
                                                    YAxes="{Binding EjesY}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="White" CornerRadius="16"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="💧  Eventos de Riego"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,12"/>
                                <ListBox x:Name="ListaEventosGrafica" BorderThickness="0"
                                         Background="Transparent" MaxHeight="160"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══════════ CONTROL ══════════ -->
                    <Grid x:Name="PanelControl" Visibility="Collapsed" Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="16"
                                Margin="0,0,16,0" Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="Panel de Control"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,20"/>
                                <Border Background="#EFF6FF" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="💧  Riego Automático"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                                <TextBlock Text="Controlado por el sensor"
                                                           FontSize="12" Foreground="#6B7280"/>
                                            </StackPanel>
                                            <Border Background="#DBEAFE" CornerRadius="8" Padding="12,5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtRiegoCtrl" Text="OFF"
                                                           FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtEstadoRiegoCtrl" Text="Estado: Inactivo"
                                                   FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="12" Padding="16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🌱  Fertilización Manual"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock Text="Control directo"
                                                       FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                        <TextBlock Text="Estado: Inactivo" FontSize="12" Foreground="#6B7280"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Sidebar conexiones -->
                        <Border Grid.Column="1" Background="White" CornerRadius="16"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="Conexiones" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,20"/>

                                <TextBlock Text="🤖  Maestro ESP32 — TCP"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock Text="📶  ROBOT_MAESTRO  →  clave: 12345678"
                                               FontSize="12" Foreground="#15803D"/>
                                </Border>
                                <TextBlock Text="IP del Maestro" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtIP" Height="38" Margin="0,0,0,8"
                                         FontSize="14" Padding="10,0" Text="192.168.4.1"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="Puerto TCP: 8888 (fijo)" FontSize="11"
                                           Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                <Button x:Name="BtnConectar" Content="Conectar" Height="40"
                                        Style="{StaticResource BtnPrimario}" Click="BtnConectar_Click"/>
                                <TextBlock x:Name="TxtError" Text="" FontSize="12"
                                           Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                <Separator Margin="0,16"/>

                                <TextBlock Text="🌱  Esclavo ESP32 — HTTP"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#374151" Margin="0,0,0,8"/>
                                <Border Background="#F0F9FF" CornerRadius="8"
                                        BorderBrush="#BAE6FD" BorderThickness="1"
                                        Padding="12,8" Margin="0,0,0,8">
                                    <TextBlock Text="📡  Polling cada 3 s  →  GET /leer"
                                               FontSize="12" Foreground="#0369A1"/>
                                </Border>
                                <TextBlock Text="IP del Esclavo" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtIPEsclavo" Height="38" Margin="0,0,0,8"
                                         FontSize="14" Padding="10,0" Text="192.168.4.2"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="Puerto HTTP: 80 (fijo)" FontSize="11"
                                           Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                <Button x:Name="BtnConectarEsclavo" Content="Conectar esclavo"
                                        Height="40" Background="#0EA5E9" Foreground="White"
                                        BorderThickness="0" Click="BtnConectarEsclavo_Click"/>
                                <TextBlock x:Name="TxtErrorEsclavo" Text="" FontSize="12"
                                           Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══════════ ANÁLISIS ══════════ -->
                    <Grid x:Name="PanelAnalisis" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="16"
                                Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                            <StackPanel Margin="24">
                                <TextBlock Text="Análisis del Sistema"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="12"
                                            Margin="0,0,8,0" Padding="20">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtKpiHumedad" Text="--%"
                                                       FontSize="32" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Humedad promedio" FontSize="12"
                                                       Foreground="#6B7280" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12"
                                            Margin="0,0,8,0" Padding="20">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtKpiRiegos" Text="0"
                                                       FontSize="32" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Riegos esta sesión" FontSize="12"
                                                       Foreground="#6B7280" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="12" Padding="20">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtKpiEstado" Text="--"
                                                       FontSize="32" FontWeight="Bold"
                                                       Foreground="#111827" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Estado actual" FontSize="12"
                                                       Foreground="#6B7280" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
